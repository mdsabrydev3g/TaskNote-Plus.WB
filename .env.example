# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/tasknote?sslmode=require"
# Neon direct (non-pooled) connection string (used by migrations)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/tasknote?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# ── AI Gateway (all optional — the app degrades gracefully without any) ─────
# Free-tier friendly providers. Priority order is resolved in src/lib/ai/gateway.ts
# Groq — free tier, very fast (https://console.groq.com/keys)
GROQ_API_KEY=""
# Google AI Studio / Gemini — generous free tier (https://aistudio.google.com/apikey)
GOOGLE_AI_API_KEY=""
# OpenRouter — has explicitly free models (https://openrouter.ai/keys)
OPENROUTER_API_KEY=""
# Ollama — 100% local, no key, no data leaves the machine (https://ollama.com)
OLLAMA_BASE_URL=""
OLLAMA_MODEL=""

# Optional: force a specific provider: groq | google | openrouter | ollama | none
AI_PROVIDER=""

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="TaskNote Plus"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
